# Copy this file to .env and fill in your values.

# Port the webhook server listens on
PORT=3000

# Any secret string you make up. Paste the same value into the Meta app's
# webhook settings ("Verify token").
VERIFY_TOKEN=change-me-to-a-random-string

# Meta app > Instagram > API setup with Instagram login > "Instagram app secret".
# Used to check that webhook calls really come from Instagram.
APP_SECRET=

# Long-lived Instagram user access token (generated in the same API setup page).
IG_ACCESS_TOKEN=

# Graph API version
IG_API_VERSION=v23.0

# Path to your rules file
RULES_FILE=./rules.json

# Set to true to log what would be sent without calling Instagram
DRY_RUN=false
